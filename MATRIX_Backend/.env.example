APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# Comma-separated list of exact frontend origins (no trailing slash, no wildcard).
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Supabase Project ─────────────────────────────────────────────────────────
# Copy these values from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-existing-project-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-existing-project-service-role-key

# ── Supabase JWT Verification ────────────────────────────────────────────────
# From: Project Settings → API → JWT Settings
# SUPABASE_JWT_ISSUER  = https://<project-ref>.supabase.co/auth/v1
# SUPABASE_JWKS_URL    = https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_AUDIENCE = authenticated   ← Supabase default; verify in your project
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_LEEWAY_SECONDS=30

# ── Supabase Profile Column ──────────────────────────────────────────────────
# The column in your `profiles` table that holds the auth.users UUID.
# Default is `id` for the standard MATRIX schema.
SUPABASE_PROFILE_USER_ID_COLUMN=id

# ── Admin Configuration ──────────────────────────────────────────────────────
# The auth.users UUID of the designated MATRIX administrator account.
# Obtain from: Supabase Dashboard → Authentication → Users → (your admin account) → Copy User UID
MATRIX_ADMIN_USER_ID=replace-with-existing-admin-auth-user-uuid

# ── Email Delivery (Resend) ──────────────────────────────────────────────────
# Required for the admin activation-code issuance feature.
# Leave blank if you are not using activation code email delivery.
RESEND_API_KEY=replace-with-resend-api-key
MATRIX_EMAIL_FROM=matrix@your-domain.com

# ── n8n Agent Layer (server-side only) ───────────────────────────────────────
# NEVER expose these values in frontend VITE_ variables or logs.
# Production webhook URL for the existing matrix-agent-layer workflow:
N8N_WEBHOOK_URL=https://abhinull.app.n8n.cloud/webhook/matrix-agent-layer
# The Header Auth credential name and value configured in n8n:
N8N_AUTH_HEADER_NAME=x-matrix-secret
N8N_AUTH_HEADER_VALUE=replace-with-existing-n8n-header-auth-value
# Workflow timeout in seconds. The n8n workflow typically takes 2-3 minutes.
# Set to 240 (4 minutes) to allow completion. If your proxy has a shorter
# timeout (e.g., Cloudflare 100s / Railway 60s), the assessment will be
# stored as 'pending' and the response will include the assessment_id so
# the user can check results later via GET /api/v1/assessments/{assessment_id}.
N8N_TIMEOUT_SECONDS=240

# ── Supabase Storage ─────────────────────────────────────────────────────────
# Name of the PRIVATE Storage bucket where PDF reports are stored.
# Create this bucket in: Supabase Dashboard → Storage → New bucket
# Set it to PRIVATE (not public). The backend generates signed URLs for access.
MATRIX_REPORT_BUCKET=matrix-reports
